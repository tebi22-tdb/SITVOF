# Copiar a /opt/sit/.env en el VPS (chmod 600). No subir valores reales al repositorio.
#
# En tu PC (PowerShell), para subir build sin hardcodear IP/root:
#   $env:SIT_DEPLOY_HOST = "tu.dominio.o.ip"
#   $env:SIT_DEPLOY_USER = "sitdeploy"
#   .\subir-servidor.ps1

SIT_JWT_SECRET=cambiar_por_cadena_aleatoria_minimo_32_caracteres
SIT_MONGODB_URI=mongodb://sit_app:CONTRASEÑA@127.0.0.1:27017/sit_titulacion?authSource=sit_titulacion
SIT_MAIL_USERNAME=cuenta_gmail_dep_no_subir_aqui
SIT_MAIL_PASSWORD=app_password_de_gmail_no_subir_aqui
SIT_CERT_BASE_URL=https://sitvo.net
SIT_SOFFICE_PATH=/usr/bin/soffice
SIT_ANEXO92_PLANTILLA=/opt/sit/templates/anexo-9-2.docx
SIT_KEYSTORE_PATH=/opt/sit/keystore/sit-keystore.p12
SIT_KEYSTORE_PASSWORD=otra_contraseña_fuerte

# Seguridad: no crear ni sincronizar cuentas de prueba en producción
SIT_SEED_ENABLED=false
SIT_SEED_USERS_ENABLED=false
SIT_SEED_SYNC_ADMIN=false
